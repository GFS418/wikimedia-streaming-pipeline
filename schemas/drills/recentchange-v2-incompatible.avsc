              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "topic",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "Upstream Kafka topic (eqiad or codfw datacenter)."
          },
          {
            "name": "partition",
            "type": [
              "null",
              "int"
            ],
            "default": null
          },
          {
            "name": "offset",
            "type": [
              "null",
              "long"
            ],
            "default": null,
            "doc": "Offset within the upstream topic; used for continuity audits."
          },
          {
            "name": "uri",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "request_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "type",
      "type": "string",
      "doc": "edit | new | log | categorize | external. Free string upstream; unknown values are flagged in silver, not rejected."
    },
    {
      "name": "timestamp",
      "type": "long",
      "doc": "Edit time, unix seconds. Event time for watermarks (decision D3)."
    },
    {
      "name": "bot",
      "type": "boolean"
    },
    {
      "name": "id",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Recentchange row ID; absent on some log events."
