{
  "type": "record",
  "name": "RecentChange",
  "namespace": "io.github.gfs418.wikistream",
  "doc": "NEGATIVE DRILL ONLY: v1 with the required field `wiki` removed. Must be rejected.",
  "fields": [
    {
      "name": "meta",
      "type": {
        "type": "record",
        "name": "Meta",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "doc": "Unique event ID (UUID). Kafka key and silver dedup key."
          },
          {
            "name": "dt",
            "type": "string",
            "doc": "Upstream emit time, ISO-8601 UTC."
          },
          {
            "name": "domain",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
